@using System.Security.Claims
@model OCULIS.Models.TerminPregleda
@inject OCULIS.Services.Termin.IOtkazivanjeTerminaServis PolitikaOtkazivanja

@{
    ViewData["Title"] = "Termin pregleda";

    var otkazan = Model.Status == StatusTermina.Otkazan;

    var vlastitiTermin = User.IsInRole(Uloge.Kupac)
        && User.FindFirst(ClaimTypes.NameIdentifier)?.Value == Model.IdKorisnik;
}

<div class="zakazi-page">
    <div class="filter-card zakazi-card">

        <div class="reservation-header">
            <span>@(otkazan ? "TERMIN OTKAZAN" : "DETALJI TERMINA")</span>
            <h2>TERMIN PREGLEDA</h2>

            @if (otkazan)
            {
                <p>Vaš termin pregleda vida je otkazan.</p>
            }
            else
            {
                <p>Podaci o vašem terminu pregleda vida.</p>
            }
        </div>

        <div class="termin-details-grid">
            <div>
                <strong>Datum</strong>
                <span>@Model.Datum.ToString("dd.MM.yyyy")</span>
            </div>

            <div>
                <strong>Vrijeme</strong>
                <span>@Model.Vrijeme.ToString(@"hh\:mm")</span>
            </div>

            <div>
                <strong>Poslovnica</strong>
                <span>@Model.Poslovnica.Naziv — @Model.Poslovnica.Adresa</span>
            </div>

            <div>
                <strong>Korisnik</strong>
                <span>@Model.Korisnik.Ime @Model.Korisnik.Prezime</span>
            </div>

            <div>
                <strong>Status</strong>
                <span class="termin-status">@Model.Status</span>
            </div>
        </div>

        @if (vlastitiTermin && Model.Status == StatusTermina.Zakazan)
        {
            if (PolitikaOtkazivanja.MozeOtkazati(Model))
            {
                <form asp-controller="TerminPregleda"
                      asp-action="Otkazi"
                      method="post"
                      class="text-center mt-4">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-danger">
                        Otkaži termin
                    </button>
                </form>
            }
            else
            {
                <p class="text-center text-muted mt-4">
                    Termin se može otkazati najmanje 24 sata prije početka.
                </p>
            }
        }

        <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
            <a asp-action="Index" class="btn btn-oculis">
                Moji termini
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary">
                Nazad na početnu
            </a>
        </div>
    </div>
</div>